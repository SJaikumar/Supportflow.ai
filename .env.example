# Stage 4: Copy to .env and add your own key. NEVER commit .env to Git.
OPENAI_API_KEY=
SUPPORTFLOW_AI_MODEL=gpt-4o-mini
SUPPORTFLOW_EMBEDDING_MODEL=text-embedding-3-small
